# Copy to .env and fill in. NEVER commit .env (it is gitignored) or paste values into logs/UI.
# Never paste real values into THIS file either — it is tracked by git.

# NOTE: the console's API Key & Secret (= CONSUMER_KEY / CONSUMER_SECRET_KEY) are OAuth
# 1.0a credentials — THIS APP DOES NOT USE THEM. It needs the Bearer Token and the
# OAuth 2.0 Client ID + Secret from their own console sections.

# X Developer Console → docs/x-api-feasibility.md §6 checklist
X_BEARER_TOKEN=          # "Bearer Token" section — app-only token for search / user lookup
X_CLIENT_ID=             # "OAuth 2.0 Client ID and Client Secret" section → Client ID
X_CLIENT_SECRET=         # same section → Client Secret (click Generate; shown ONCE)
OAUTH_CALLBACK_URL=http://127.0.0.1:8501/callback

# Volume caps (policy I5; must stay within X limits: 15/15min, 1440/24h)
SEND_CAP_15MIN=10
SEND_CAP_24H=40

# Comma-separated X user IDs allowed as dev/test send recipients (policy I4)
TEST_RECIPIENT_ALLOWLIST=
