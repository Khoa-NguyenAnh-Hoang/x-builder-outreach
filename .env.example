# Copy to .env and fill in. NEVER commit .env (it is gitignored) or paste values into logs/UI.

# X Developer Console → docs/x-api-feasibility.md §6 checklist
X_BEARER_TOKEN=          # App-only bearer token (post search / user lookup)
X_CLIENT_ID=             # OAuth 2.0 Client ID (user-context PKCE)
X_CLIENT_SECRET=         # OAuth 2.0 Client Secret
OAUTH_CALLBACK_URL=http://127.0.0.1:8501/callback

# Volume caps (policy I5; must stay within X limits: 15/15min, 1440/24h)
SEND_CAP_15MIN=10
SEND_CAP_24H=40

# Comma-separated X user IDs allowed as dev/test send recipients (policy I4)
TEST_RECIPIENT_ALLOWLIST=
